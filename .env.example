# Скопировать в .env и поправить. .env не коммитить.

# --- ASR ---
DEVICE=cpu                    # cpu | cuda
ASR_MODEL=v3_e2e_rnnt         # v3_e2e_rnnt (точнее) | v3_e2e_ctc (быстрее)
MODEL_DIR=                    # куда качать веса GigaAM; пусто -> ~/.cache/gigaam
CPU_THREADS=0                 # 0 -> по умолчанию torch
ASR_BATCH=8
MAX_SEGMENT_S=20              # GigaAM принимает куски до 25 с
VAD_THRESHOLD=0.4             # ниже -> больше тихой речи, но и фоновых разговоров
VAD_MIN_SILENCE_MS=700        # пауза, которая разделяет фразы
VAD_SPEECH_PAD_MS=200
STEREO_MAP=client,operator    # левый канал, правый канал
REPLACEMENTS_FILE=            # автозамены; пусто -> DATA_DIR/replacements.txt
EMOTION_ENABLED=true          # эмоция по голосу (GigaAM-Emo), +~20 с на звонок на CPU
EMO_MIN_PHRASE_S=1.5          # фразы короче не оцениваем («да», «угу» дают шум)

# --- LLM (Ollama) ---
LLM_ENABLED=true
LLM_URL=http://localhost:11434
# GigaChat 3.1 Lightning (Сбер, MIT, 6.5 ГБ): ollama pull hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:Q4_K_M
# запасной вариант: qwen2.5:7b (4.7 ГБ) — хуже определяет тон, иногда отвечает по-китайски
LLM_MODEL=hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:Q4_K_M
LLM_TIMEOUT_S=300
LLM_MAX_TOKENS=1024           # предел длины ответа (защита от зацикливания)
LLM_KEEP_ALIVE=30m            # сколько Ollama держит модель в памяти после запроса

# --- Очередь ---
DATA_DIR=data                 # data/jobs.db, data/uploads
WORKERS=1
KEEP_AUDIO=false              # удалять загруженную запись после успешной обработки
INBOX_DIR=                    # папка для автоприёма файлов; пусто -> выключено

# --- Basic-auth (пусто -> выключена) ---
AUTH_USER=transcriber
AUTH_PASSWORD=change-me
