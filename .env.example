# Скопировать в .env и поправить. .env не коммитить.
# Комментарии — только на отдельных строках: Docker считает «# ...» после пустого значения частью значения.

# ===== Распознавание =====
# cpu | cuda
DEVICE=cpu
# v3_e2e_rnnt (точнее) | v3_e2e_ctc (быстрее)
ASR_MODEL=v3_e2e_rnnt
# куда качать веса GigaAM; пусто -> ~/.cache/gigaam (в Docker задаётся автоматически)
MODEL_DIR=
# потоков процессора; 0 -> по умолчанию torch
CPU_THREADS=0
ASR_BATCH=8
# GigaAM принимает куски до 25 с
MAX_SEGMENT_S=20
# VAD: ниже порог -> больше тихой речи, но и фоновых разговоров
VAD_THRESHOLD=0.4
# пауза, которая разделяет фразы
VAD_MIN_SILENCE_MS=700
VAD_SPEECH_PAD_MS=200
# стерео: левый канал, правый канал
STEREO_MAP=client,operator
# словарь автозамен; пусто -> DATA_DIR/replacements.txt
REPLACEMENTS_FILE=
# эмоция по голосу (GigaAM-Emo), +~20 с на звонок на CPU
EMOTION_ENABLED=true
# фразы короче не оцениваем («да», «угу» дают шум)
EMO_MIN_PHRASE_S=1.5

# ===== LLM (Ollama) =====
LLM_ENABLED=true
# адрес Ollama для локального запуска (в Docker — см. DOCKER_LLM_URL ниже)
LLM_URL=http://localhost:11434
# GigaChat 3.1 Lightning (Сбер, MIT, 6.5 ГБ); запасной вариант qwen2.5:7b — хуже определяет тон
LLM_MODEL=hf.co/ai-sage/GigaChat3.1-10B-A1.8B-GGUF:Q4_K_M
LLM_TIMEOUT_S=300
# предел длины ответа (защита от зацикливания)
LLM_MAX_TOKENS=1024
# сколько Ollama держит модель в памяти после запроса
LLM_KEEP_ALIVE=30m

# ===== Очередь =====
# очередь jobs.db, загрузки, словарь автозамен (в Docker задаётся автоматически)
DATA_DIR=data
WORKERS=1
# true -> не удалять запись после успешной обработки (по умолчанию удаляется: текст и саммари уже в базе)
KEEP_AUDIO=false
# папка автоприёма записей; пусто -> выключено (в Docker — всегда ./inbox)
INBOX_DIR=

# ===== Записи с АТС (make fetch-ats / docker-fetch-ats) =====
# корень папки записей на веб-сервере АТС: <ATS_URL>/ГГ/ММ/ДД/<линия>/<запись>.mp3
ATS_URL=
# учётка на чтение записей (лучше отдельная, не админская)
ATS_USER=
ATS_PASSWORD=
# какие папки линий/внутренних номеров забирать, через запятую; пусто -> все за день
ATS_LINES=
# файлы меньше — несостоявшиеся звонки
ATS_MIN_BYTES=4096
# ночной режим: во сколько забирать записи с АТС (местное время), можно несколько через запятую; пусто -> только вручную
ATS_FETCH_AT=20:30
# за сколько дней забирать: 2 — сегодня и вчера (добирает звонки после прошлого запуска)
ATS_FETCH_DAYS=2
# реальное время: эти линии проверяются часто, новый звонок обрабатывается через несколько минут после окончания;
# через запятую, пусто -> выключено (только ночной режим)
ATS_LIVE_LINES=
# как часто проверять, минут
ATS_LIVE_EVERY_MIN=2
# в какие часы (местное время); вне них звонки этих линий заберёт ночной режим
ATS_LIVE_HOURS=08:00-20:00

# ===== Хранение =====
# часовой пояс для расписания — только Docker/Linux; на Windows не нужен (берётся из системы)
TZ=Europe/Moscow
# дней хранить аудио, оставшееся после ошибок (удачно обработанное удаляется сразу); 0 -> не удалять
AUDIO_RETENTION_DAYS=7
# дней хранить результаты (текст, саммари) в базе; 0 -> всегда
RESULTS_RETENTION_DAYS=0

# ===== Доступ к API (basic-auth; пустой логин -> без пароля) =====
AUTH_USER=transcriber
AUTH_PASSWORD=change-me

# ===== Docker (docker-compose.yml) =====
# порт сервиса на хосте
PORT=8000
# 1 -> веса GigaAM внутри образа (собрать там, где есть интернет, и перенести на сервер без интернета)
PRELOAD_MODELS=0
# версия образа ollama/ollama; на сервере лучше закрепить конкретную
OLLAMA_VERSION=latest
# пусто -> LLM из контейнера ollama; иначе внешний Ollama, например http://10.0.0.5:11434
DOCKER_LLM_URL=
